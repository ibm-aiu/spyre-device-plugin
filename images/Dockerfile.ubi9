ARG BASE_UBI_IMAGE_TAG=9.6
ARG BUILDER_IMAGE
FROM ${BUILDER_IMAGE:-registry.access.redhat.com/ubi9/go-toolset:1.26.4-1783442369} AS builder
ARG TARGETOS
ARG TARGETARCH

USER root

WORKDIR /workspace

COPY go.mod .
COPY go.sum .
COPY vendor/ vendor/

COPY cmd/ cmd/
COPY pkg/ pkg/
# Build
ARG BUILD_FLAGS=""

ENV GOTOOLCHAIN="local"

RUN echo "TARGETARCH: ${TARGETARCH}" && \
    echo "TARGETOS: ${TARGETOS}" && \
    echo -n "GOVERSION: " && go env GOVERSION && \
    echo -n "GOTOOLCHAIN: " && go env GOTOOLCHAIN && \
    echo -n "GOPROXY: " && go env GOPROXY && \
    CGO_ENABLED=1 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" GO111MODULE=on GOTOOLCHAIN="${GOTOOLCHAIN}" \
    go build ${BUILD_FLAGS} -mod vendor -tags strictfipsruntime -a -o spyre-device-plugin ./cmd/spyre

RUN --mount=type=cache,target=/var/cache/dnf \
    dnf --installroot=/tmp/ubi-micro --nodocs --setopt=install_weak_deps=False --releasever=9 \
    install -y pciutils openssl-libs openssl-fips-provider && \
    dnf --installroot=/tmp/ubi-micro \
    clean all

# generate minimal image
FROM registry.access.redhat.com/ubi9/ubi-micro:${BASE_UBI_IMAGE_TAG}

WORKDIR /

ARG VERSION

LABEL io.k8s.display-name="IBM Spyre Operator Device Plugin"
LABEL name="IBM Spyre Operator Device Plugin"
LABEL vendor="IBM"
LABEL version="${VERSION}"
LABEL release="N/A"
LABEL summary="Automate the management and monitoring of IBM Spyre devices."
LABEL description="See summary"

# Create directories with proper permissions
# Using UID 1001, GID 0 (root group) for non-root container with root group access
# No need to create user in ubi-micro - we'll just set ownership
RUN mkdir -p /usr/local/etc/device-plugins/spyre-config && \
    mkdir -p /usr/local/etc/device-plugins/spyre-metrics && \
    mkdir -p /usr/local/etc/device-plugins/metadata && \
    mkdir -p /var/lib/kubelet/plugins_registry && \
    mkdir -p /var/lib/kubelet/device-plugins && \
    chown -R 1001:0 /usr/local/etc/device-plugins && \
    chmod -R u+rwX /usr/local/etc/device-plugins

COPY --from=builder /workspace/spyre-device-plugin /usr/bin/
COPY --from=builder /tmp/ubi-micro/ /
COPY ./LICENSE /licenses/LICENSE

# Switch to non-root user (UID 1001) with root group (GID 0)
USER 1001:0
EXPOSE 8081
ENTRYPOINT ["/usr/bin/spyre-device-plugin","--logtostderr"]
CMD ["--v=10"]
HEALTHCHECK NONE
